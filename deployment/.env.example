# Docker Compose loads this file automatically (same directory as docker-compose.yml).
# Copy to .env and fill in secrets. Do not commit .env.

# ---------- Nginx (published edge) ----------
NGINX_HTTP_BIND=0.0.0.0

# ---------- Public URL (browser / NextAuth) ----------
# On the VPS use its address, e.g. http://203.0.113.10 (same value in NEXT_PUBLIC_APP_URL).
PUBLIC_APP_URL=http://localhost
NEXTAUTH_URL=http://localhost

# ---------- PostgreSQL (internal 5432 on Docker network) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=redsea
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PASSWORD=

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_HEALTH_URL=http://localhost:9000/minio/health/live
MINIO_CONSOLE_ADDRESS=:9001

# ---------- NestJS backend ----------
PORT=8080
APP_SECRET_KEY=

DATABASE_NAME=redsea
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
# Both colors share this database. Keep synchronize off so a new color only applies migrations.
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_MIGRATIONS_RUN=true
DATABASE_SSL=false

REDIS_HOST=redis
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=
BUCKET_NAME=red-sea
AWS_REGION=ap-southeast-1
# Inside the Docker network (backend -> MinIO).
AWS_ENDPOINT=http://minio:9000
# Host the browser uses for presigned PUT/GET links. nginx serves the bucket at /BUCKET_NAME/
# on port 80, so this is the app address with no port and no bucket, e.g. http://203.0.113.10.
# The bucket is private: files only open through links signed by the backend.
AWS_PUBLIC_ENDPOINT=http://localhost

GPS_SYNC_ENABLED=true
GPS_API_URL=https://gps.fmsgps.co/api
# Interpolated as GPS_API_HashKey for Nest ($$ becomes $ in compose)
GPS_API_HASH=

# ---------- Next.js ----------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_BACKEND_URL=
NEXTAUTH_SECRET=

# ---------- Release smoke users (VPS only) ----------
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
SMOKE_EMPLOYEE_EMAIL=
SMOKE_EMPLOYEE_PASSWORD=
# Passwords the seed gives admin@admin.com and user@user.com. Match the smoke passwords above.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# ---------- Release images (VPS only; workstation builds ignore these) ----------
# Full registry digests from the release job, for example ghcr.io/anter0101/red-sea-backend@sha256:<64 hex>.
BACKEND_IMAGE=
FRONTEND_IMAGE=
# Full git SHA of the release that those digests were built from.
APP_RELEASE_SHA=
# Written to /opt/redsea/state/active.json by the traffic switch. Each container's color is set in Compose.
APP_COLOR=
