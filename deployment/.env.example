# Docker Compose loads this file automatically (same directory as docker-compose.yml).
# Copy to .env and fill in secrets. Do not commit .env.

# ---------- Nginx (published edge) ----------
NGINX_HTTP_BIND=0.0.0.0

# ---------- Public URL (browser / NextAuth) ----------
PUBLIC_APP_URL=http://localhost
NEXTAUTH_URL=http://localhost

# ---------- PostgreSQL (internal 5432 on Docker network) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=redsea
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PASSWORD=

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_HEALTH_URL=http://localhost:9000/minio/health/live
MINIO_CONSOLE_ADDRESS=:9001

# ---------- NestJS backend ----------
PORT=8080
APP_SECRET_KEY=

DATABASE_NAME=redsea
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_MIGRATIONS_RUN=true
DATABASE_SSL=false

REDIS_HOST=redis
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=
BUCKET_NAME=red-sea
AWS_REGION=ap-southeast-1
AWS_ENDPOINT=http://minio:9000

GPS_SYNC_ENABLED=true
GPS_API_URL=https://gps.fmsgps.co/api
# Interpolated as GPS_API_HashKey for Nest ($$ becomes $ in compose)
GPS_API_HASH=

# ---------- Next.js ----------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_BACKEND_URL=
NEXTAUTH_SECRET=
